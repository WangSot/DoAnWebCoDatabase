// Database cho website "Phở ngon 123"
// Dùng SQLite cho đơn giản (chỉ là 1 file dev.db). Muốn đổi sang MySQL/PostgreSQL
// thì chỉ cần sửa provider và DATABASE_URL trong file .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Món ăn trong trang "Thực đơn" (menu.html) và danh sách chọn món ở "Đặt món" (datmon.html)
model MenuItem {
  id          Int      @id @default(autoincrement())
  slug        String   @unique            // vd: "photai", "phoga" (trùng value của <option>)
  name        String                      // vd: "Phở tái"
  price       Int                         // đơn vị VNĐ, vd: 40000
  imageUrl    String?                     // vd: "imgs/photai.webp"
  description String?
  isAvailable Boolean  @default(true)     // false = tạm hết món
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
}

// Đơn hàng từ form "THÔNG TIN ĐẶT HÀNG"
model Order {
  id           Int         @id @default(autoincrement())
  customerName String                    // Họ và tên
  phone        String                    // Số điện thoại
  address      String                    // Địa chỉ
  note         String?
  totalPrice   Int         @default(0)   // tổng tiền (VNĐ)
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        OrderItem[]

  @@index([phone])
  @@index([status])
}

// Chi tiết từng món trong 1 đơn (cho phép 1 đơn có nhiều món sau này)
model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int      @default(1)        // Số lượng
  unitPrice  Int                         // giá tại thời điểm đặt (để sau này đổi giá không ảnh hưởng đơn cũ)

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

enum OrderStatus {
  PENDING     // Mới đặt, chờ gọi xác nhận
  CONFIRMED   // Đã xác nhận
  DELIVERING  // Đang giao
  COMPLETED   // Hoàn thành
  CANCELLED   // Đã huỷ
}
